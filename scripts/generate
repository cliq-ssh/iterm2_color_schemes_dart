#!/bin/bash
set -euo pipefail

script_dir=$(dirname "$(readlink -f "$0")")

repo_dir="$script_dir/../.dart_tool/iTerm2-Color-Schemes/kitty"
target_schemes_file="$script_dir/../lib/src/iterm2_color_schemes.g.dart"
target_values_file="$script_dir/../lib/src/iterm2_color_schemes_values.g.dart"
screenshot_base_url="https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/screenshots"

if [ ! -d "$repo_dir" ]; then
  echo "Directory '$repo_dir' does not exist. Please run './download' first." >&2
  exit 1
fi

# fields in the order they appear in the ITerm2ColorScheme constructor
color_fields=(
  black red green yellow blue purple cyan white
  brightBlack brightRed brightGreen brightYellow brightBlue brightPurple brightCyan brightWhite
  background foreground cursor cursorText selectionForeground selectionBackground
)

function getConfKeyFor() {
  case "$1" in
    black) echo color0 ;;
    red) echo color1 ;;
    green) echo color2 ;;
    yellow) echo color3 ;;
    blue) echo color4 ;;
    purple) echo color5 ;;
    cyan) echo color6 ;;
    white) echo color7 ;;
    brightBlack) echo color8 ;;
    brightRed) echo color9 ;;
    brightGreen) echo color10 ;;
    brightYellow) echo color11 ;;
    brightBlue) echo color12 ;;
    brightPurple) echo color13 ;;
    brightCyan) echo color14 ;;
    brightWhite) echo color15 ;;
    background) echo background ;;
    foreground) echo foreground ;;
    cursor) echo cursor ;;
    cursorText) echo cursor_text_color ;;
    selectionForeground) echo selection_foreground ;;
    selectionBackground) echo selection_background ;;
  esac
}

# field -> conf key, computed once instead of per file (saves ~9000 subshells)
conf_keys=()
for field in "${color_fields[@]}"; do
  conf_keys+=("$(getConfKeyFor "$field")")
done

# convert an arbitrary string into a lowerCamelCase Dart identifier
function toCamelCase() {
  local input="$1"
  input="${input//+/ Plus}"

  local normalized
  normalized=$(echo "$input" | sed -E 's/[^A-Za-z0-9]+/ /g' | sed -E 's/^ +| +$//g')

  local result=""
  local first=true
  for word in $normalized; do
    local lower_word
    lower_word=$(echo "$word" | tr '[:upper:]' '[:lower:]')
    if [ "$first" = true ]; then
      result="$lower_word"
      first=false
    else
      local head="${word:0:1}"
      local tail="${lower_word:1}"
      head=$(echo "$head" | tr '[:lower:]' '[:upper:]')
      result="${result}${head}${tail}"
    fi
  done

  # Dart identifiers cant start with a digit
  if [[ "$result" =~ ^[0-9] ]]; then
    local first_char="${result:0:1}"
    local rest="${result:1}"
    first_char=$(echo "$first_char" | tr '[:lower:]' '[:upper:]')
    result="scheme${first_char}${rest}"
  fi

  echo "$result"
}

function toSlug() {
  local input="$1"
  echo "$input" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g' \
    | sed -E 's/^-+|-+$//g'
}

# turn a file basename like "solarized-dark" into "Solarized Dark"
function toTitleCase() {
  local input="$1"
  echo "$input" \
    | sed -E 's/[_-]+/ /g' \
    | awk '{for (i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print}'
}

# Dart hex literals are case-insensitive, so no need to uppercase (skips a tr call per color)
function toColorInt() {
  echo "0xFF${1#\#}"
}

# look up a value for `key` from parallel arrays built by readConfFile
function lookupConfValue() {
  local key="$1"
  local i
  for i in "${!file_keys[@]}"; do
    if [ "${file_keys[$i]}" = "$key" ]; then
      echo "${file_vals[$i]}"
      return
    fi
  done
}

# read every "key value" pair from a conf file once into file_keys/file_vals
function readConfFile() {
  local conf_file="$1"
  file_keys=()
  file_vals=()
  while IFS=' ' read -r k v _; do
    [ -z "$k" ] && continue
    file_keys+=("$k")
    file_vals+=("$v")
  done < <(grep -E '^[a-zA-Z_0-9]+[[:space:]]+#' "$conf_file" || true)
}

function genClassHeader() {
  local class_name="$1"
  echo "import 'package:iterm2_color_schemes_dart/iterm2_color_schemes_dart.dart';"
  echo ""
  echo "// GENERATED CODE - DO NOT MODIFY BY HAND"
  echo ""
  echo "/// Color schemes provided by https://github.com/mbadolato/iTerm2-Color-Schemes"
  echo "class $class_name {"
  echo "  const $class_name._();"
  echo ""
}

function genColorSchemeMethod() {
  local method_name="$1"
  local color_scheme_name="$2"
  local screenshot_url="$3"
  shift 3
  local values=("$@")

  echo "/// ## $color_scheme_name"
  echo "///"
  echo "/// <img src=\"$screenshot_url\" width=\"400\" />"
  echo "static const ITerm2ColorScheme $method_name = ITerm2ColorScheme("
  echo "name: '${color_scheme_name//\'/\\\'}',"
  local i
  for i in "${!color_fields[@]}"; do
    echo "${color_fields[$i]}: ${values[$i]},"
  done
  echo ");"
}

# remove target files
if [ -f "$target_schemes_file" ]; then
  echo "Removing existing target files '$target_schemes_file', '$target_values_file'..."
  rm -f "$target_schemes_file" "$target_values_file"
fi

# both outputs live in the same dir, one mkdir covers both
mkdir -p "$(dirname "$target_schemes_file")"
echo "Generating Dart code..."

names=()
display_names=()
contents=()

while IFS= read -r -d '' conf_file; do
  file_basename=$(basename "$conf_file" .conf)
  color_scheme_name=$(toTitleCase "$file_basename")

  readConfFile "$conf_file"

  values=()
  for i in "${!color_fields[@]}"; do
    key="${conf_keys[$i]}"
    hex=$(lookupConfValue "$key")
    if [ -z "$hex" ]; then
      echo "Warning: Missing key '$key' in '$conf_file', skipping file" >&2
      values=()
      break
    fi
    values+=("$(toColorInt "$hex")")
  done

  if [ "${#values[@]}" -eq 0 ]; then
    continue
  fi

  method_name=$(toCamelCase "$file_basename")

  # dedupe check via linear scan
  duplicate=0
  for existing in "${names[@]:-}"; do
    if [ "$existing" = "$method_name" ]; then
      duplicate=1
      break
    fi
  done
  if [ "$duplicate" -eq 1 ]; then
    echo "Warning: Skipping duplicate method name '$method_name' (file: '$file_basename')" >&2
    continue
  fi

  screenshot_url="$screenshot_base_url/$(toSlug "$file_basename").png"
  names+=("$method_name")
  display_names+=("$color_scheme_name")
  contents+=("$(genColorSchemeMethod "$method_name" "$color_scheme_name" "$screenshot_url" "${values[@]}")")
done < <(find "$repo_dir" -type f -name '*.conf' -print0 | sort -z)

genClassHeader "ITerm2ColorSchemes" > "$target_schemes_file"

# sort by display name
sort_data=$(for i in "${!names[@]}"; do printf '%s\t%d\n' "${display_names[$i]}" "$i"; done | sort)

sorted_indices=()
while IFS=$'\t' read -r _ idx; do
  sorted_indices+=("$idx")
done <<< "$sort_data"

for idx in "${sorted_indices[@]}"; do
  echo "${contents[$idx]}" >> "$target_schemes_file"
  echo "" >> "$target_schemes_file"
done

# generate a full list for iteration
{
  echo "import 'color_scheme.model.dart';"
  echo "import 'iterm2_color_schemes.g.dart';"
  echo ""
  echo "// GENERATED CODE - DO NOT MODIFY BY HAND"
  echo ""
  echo "/// A list of all available color schemes."
  echo "///"
  echo "/// Import this file only if you need to enumerate ALL color schemes."
  echo "/// Importing it prevents tree-shaking of unused individual schemes."
  echo "const List<ITerm2ColorScheme> iterm2ColorSchemeValues = ["
  for idx in "${sorted_indices[@]}"; do
    echo "ITerm2ColorSchemes.${names[$idx]},"
  done
  echo "];"
} > "$target_values_file"

echo "}" >> "$target_schemes_file"

# format generated code if dart is available
if command -v dart >/dev/null 2>&1; then
  dart format "$target_schemes_file"
  dart format "$target_values_file"
else
  echo "Dart is not installed, skipping formatting." >&2
fi