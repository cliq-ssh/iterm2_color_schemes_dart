#!/bin/bash
set -euo pipefail

script_dir=$(dirname "$(readlink -f "$0")")
pubspec_file="$script_dir/../pubspec.yaml"

current_version=$(sed -n 's/^version:[[:space:]]*//p' "$pubspec_file")
if [[ ! "$current_version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "Invalid current package version '$current_version'. Expected semantic version X.Y.Z." >&2
  exit 1
fi

major=${BASH_REMATCH[1]}
minor=${BASH_REMATCH[2]}
minor=$((minor + 1))

while git -C "$script_dir/.." rev-parse -q --verify "refs/tags/v$major.$minor.0" >/dev/null; do
  minor=$((minor + 1))
done

echo "$major.$minor.0"
